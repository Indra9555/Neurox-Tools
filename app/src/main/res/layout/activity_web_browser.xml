<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowserHome"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✖"
            android:textColor="#FF3B30"
            android:textSize="16sp"
            app:paddingStart="0dp"
            app:paddingEnd="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowserBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:paddingStart="0dp"
            app:paddingEnd="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowserForward"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="→"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:paddingStart="0dp"
            app:paddingEnd="0dp"/>

        <EditText
            android:id="@+id/etUrlInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Search or enter URL"
            android:inputType="textUri"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:imeOptions="actionGo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowserRefresh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⟳"
            android:textColor="#00D2FF"
            android:textSize="18sp"
            app:paddingStart="0dp"
            app:paddingEnd="0dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/browserProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressTint="#00D2FF"
        android:visibility="gone" />

    <WebView
        android:id="@+id/coreWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>